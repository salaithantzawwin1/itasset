[TEMPLATE]
# Copy to .env — never commit the real file.
DJANGO_ENV=dev
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
DATABASE_URL=postgresql://itasset:itasset@127.0.0.1:5432/itasset
REDIS_URL=redis://127.0.0.1:6379/0
LDAP_ENABLED=0
RUNHOST=0.0.0.0
# Email alerts (§14 notification matrix) — SMTP in prod; dev defaults to console backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=itasset@localhost
IT_LEAD_EMAIL=
PROCUREMENT_EMAIL=
# §14 daily activity digest recipients (falls back to IT_LEAD_EMAIL when blank)
ADMIN_EMAIL=